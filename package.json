{
  "name": "dead-pixels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DEAD PIXELS - a 2D puzzle-platformer trapped inside a 1980s CRT television. Ludum Dare 60: OLD TECH.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "qa": "node qa-full.cjs && node qa-campaign.cjs",
    "qa:regression": "node qa-full.cjs",
    "qa:campaign": "node qa-campaign.cjs",
    "qa:health": "node qa-health.cjs",
    "qa:hazard-models": "node qa-hazard-models.cjs",
    "qa:audio": "node qa-audio.cjs",
    "qa:menu": "node qa-menu.cjs",
    "qa:intro": "node qa-intro.cjs",
    "qa:survival": "QA_DAMAGE=1 node qa-campaign.cjs",
    "qa:release": "npm run qa:health && npm run qa:hazard-models && npm run qa:menu && npm run qa:intro && npm run qa:audio && npm run qa"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
